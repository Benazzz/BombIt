<UserControl x:Class="BombIt.Client.Controls.ColorWheel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="220">
        <TextBlock Text="2. Pick a color" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>

        <Grid Width="200" Height="200">
            <Image x:Name="WheelImage" Width="200" Height="200" Cursor="Cross"
                   MouseLeftButtonDown="Wheel_MouseDown"
                   MouseMove="Wheel_MouseMove"
                   MouseLeftButtonUp="Wheel_MouseUp"/>
            <Canvas Width="200" Height="200" IsHitTestVisible="False">
                <Ellipse x:Name="Marker" Width="14" Height="14"
                         Stroke="Black" StrokeThickness="2" Fill="White"/>
            </Canvas>
        </Grid>

        <TextBlock Text="Brightness" Foreground="LightGray" Margin="0,10,0,0"/>
        <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="1" Value="1"
                ValueChanged="Brightness_ValueChanged" Margin="0,5,0,0"/>
    </StackPanel>
</UserControl>
